# Security headers for the admin page (static asset). Kept minimal on purpose so nothing
# in the page (inline styles, pdf.js) is blocked: no clickjacking, no MIME sniffing,
# no referrer leak, no plugins or <base> tag injection.
/admin.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
