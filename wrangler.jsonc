{
  // Cosmo Dental document Q&A assistant (RAG)
  // Runs entirely on the Cloudflare Workers FREE plan. No payment card needed:
  // on the free plan, going over a daily limit makes requests fail instead of billing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmodental-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static files: admin page (/admin.html) and the chat widget (/widget.js)
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },

  // Workers AI: embeddings (bge-m3) + answer generation (Llama 3.1 8B)
  "ai": { "binding": "AI" },

  // Vector database. Create once with:
  //   npx wrangler vectorize create cosmodental-docs --dimensions=1024 --metric=cosine
  "vectorize": [{ "binding": "VECTORS", "index_name": "cosmodental-docs" }],

  // SQL database for documents, chunk text and anonymous question logs. Create once with:
  //   npx wrangler d1 create cosmodental-assistant   (then paste the database_id below)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cosmodental-assistant",
      "database_id": "b59c4cb2-fa3c-492f-975d-09721adf3e1c",
    },
  ],

  "vars": {
    "EMBED_MODEL": "@cf/baai/bge-m3",
    "CHAT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "TOP_K": "5",
    "MIN_SCORE": "0.45",
    "ALLOWED_ORIGINS": "https://www.cosmodentalusa.com,https://cosmodentalusa.com,http://localhost:3000",
    "CLINIC_PHONE": "(708) 345-6313",
  },
  // Secret (not stored in this file): npx wrangler secret put ADMIN_TOKEN
}
